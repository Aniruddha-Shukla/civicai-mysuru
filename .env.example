# ─────────────────────────────────────────────────────────────────────────────
# CivicAI Mysuru — environment variables. Copy to `.env` for local development
# (never commit `.env`). On Vercel, set these in Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────────────────

# Database (Supabase Postgres)
# Pooled connection (pgbouncer, port 6543) — used by the app at runtime on serverless.
DATABASE_URL="postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct connection (port 5432) — used only by `prisma migrate`.
DIRECT_URL="postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Supabase Auth + Storage
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-public-anon-key"
# SERVER ONLY — never prefix with NEXT_PUBLIC_. Used for private photo storage and the demo seed.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# AI layer (optional) — Google Gemini. A free key from https://aistudio.google.com/apikey works.
# Leave GEMINI_API_KEY empty to run in template-only (degraded) mode.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"

# Map (optional). Without it the ward picker falls back to a searchable list.
NEXT_PUBLIC_MAPBOX_TOKEN=""

# Scheduled sync. At least 16 random characters, e.g. `openssl rand -hex 32`.
# Vercel Cron sends it automatically as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET="replace-with-a-long-random-string"

# Optional email channel (Resend). In-app notifications always work without it.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="CivicAI Mysuru <onboarding@resend.dev>"

# Demo data (seeded locally by `npx prisma db seed` and on every Vercel build).
SEED_DEMO_DATA="true"
DEMO_CITIZEN_EMAIL="citizen@civicai.example"
DEMO_CITIZEN_PASSWORD="CivicAI-Citizen-2026"
DEMO_OPERATOR_EMAIL="operator@civicai.example"
DEMO_OPERATOR_PASSWORD="CivicAI-Operator-2026"
